<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kusatsu.Pages.CategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kusatsu.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Maiko.Models"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid
        Padding="24,16"
        RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="Categories"
            Style="{StaticResource TitleTextBlockStyle}" />

        <Border
            Grid.Row="1">
            <Grid
                RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.Resources>
                    <DataTemplate
                        x:Key="LargeTemplate"
                        x:DataType="models:LargeCategory">
                        <muxc:TreeViewItem
                            ItemsSource="{x:Bind MediumCategories}">
                            <controls:DataRow>
                                <TextBlock Text="{x:Bind Id}" />
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Budget}" />
                                <TextBlock Text="{x:Bind TotalIncome}" />
                                <TextBlock Text="{x:Bind TotalExpense}" />
                                <TextBlock Text="{x:Bind MonthlyTotal}" />
                            </controls:DataRow>
                        </muxc:TreeViewItem>
                    </DataTemplate>

                    <DataTemplate
                        x:Key="MediumTemplate"
                        x:DataType="models:MediumCategory">
                        <muxc:TreeViewItem
                            ItemsSource="{x:Bind SmallCategories}">
                            <controls:DataRow>
                                <TextBlock Text="{x:Bind Id}" />
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Budget}" />
                                <TextBlock Text="{x:Bind TotalIncome}" />
                                <TextBlock Text="{x:Bind TotalExpense}" />
                                <TextBlock Text="{x:Bind MonthlyTotal}" />
                            </controls:DataRow>
                        </muxc:TreeViewItem>
                    </DataTemplate>

                    <DataTemplate
                        x:Key="SmallTemplate"
                        x:DataType="models:SmallCategory">
                        <muxc:TreeViewItem>
                            <controls:DataRow>
                                <TextBlock Text="{x:Bind Id}" />
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Budget}" />
                                <TextBlock Text="{x:Bind TotalIncome}" />
                                <TextBlock Text="{x:Bind TotalExpense}" />
                                <TextBlock Text="{x:Bind MonthlyTotal}" />
                            </controls:DataRow>
                        </muxc:TreeViewItem>
                    </DataTemplate>

                    <local:CategoryTemplateSelector
                        LargeTemplate="{StaticResource LargeTemplate}"
                        MediumTemplate="{StaticResource MediumTemplate}"
                        SmallTemplate="{StaticResource SmallTemplate}"
                        x:Key="CategoryTemplateSelector" />
                </Grid.Resources>

                <controls:HeaderedTreeView
                    ItemsSource="{x:Bind viewModel.LargeCategories}"
                    SelectedItem="{x:Bind viewModel.Category, Mode=TwoWay}"
                    ItemTemplateSelector="{StaticResource CategoryTemplateSelector}">
                    <controls:HeaderedTreeView.Header>
                        <controls:DataTable ColumnSpacing="8">
                            <controls:DataColumn
                                DesiredWidth="Auto"
                                x:Uid="/DataTableResources/Id" />
                            <controls:DataColumn
                                DesiredWidth="*"
                                x:Uid="/DataTableResources/Name" />
                            <controls:DataColumn
                                x:Uid="/DataTableResources/Budget"
                                DesiredWidth="95" />
                            <controls:DataColumn
                                DesiredWidth="95"
                                x:Uid="/DataTableResources/Income" />
                            <controls:DataColumn
                                DesiredWidth="95"
                                x:Uid="/DataTableResources/Expense" />
                            <controls:DataColumn
                                DesiredWidth="120"
                                x:Uid="/DataTableResources/Monthly" />
                        </controls:DataTable>
                    </controls:HeaderedTreeView.Header>
                </controls:HeaderedTreeView>

                <CommandBar
                    Grid.Row="1"
                    DefaultLabelPosition="Bottom">
                    <AppBarButton
                        x:Uid="/ButtonResources/Add"
                        Icon="Add"
                        Command="{x:Bind viewModel.AddCommand}" />
                    <AppBarButton
                        x:Uid="/ButtonResources/Detail"
                        Icon="More"
                        Command="{x:Bind viewModel.InvokeCommand}" />
                    <AppBarButton
                        x:Uid="/ButtonResources/Sync"
                        Icon="Sync"
                        Command="{x:Bind viewModel.LoadCommand}" />
                </CommandBar>
            </Grid>
        </Border>
    </Grid>
</Page>
