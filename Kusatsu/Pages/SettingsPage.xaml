<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Kusatsu.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kusatsu.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" x:Uid="Settings" />
        <ScrollViewer Grid.Row="1">
            <Grid>
                <StackPanel Spacing="8">
                    <controls:SettingsCard
                            x:Name="CategoryJumper"
                            x:Uid="Category"
                            IsClickEnabled="True"
                            HeaderIcon="{ui:SymbolIcon Symbol=Flag}">
                        <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="CategoryJumpText" />
                    </controls:SettingsCard>

                    <controls:SettingsExpander
                            x:Name="LocalAI"
                            x:Uid="LocalAIEnabled"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE99A;}">
                        <ToggleSwitch
                                IsOn="{x:Bind viewModel.IsAIEnabled, Mode=TwoWay}"
                                x:Uid="/ControlResources/LocalAISwitch" />
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard
                                x:Uid="ChatModel"
                                HeaderIcon="{ui:FontIcon Glyph=&#xE8F2;}">
                                <ComboBox
                                    ItemsSource="{x:Bind viewModel.Models}"
                                    SelectedIndex="{x:Bind viewModel.OllamaModelIndex, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard
                                x:Uid="EmbeddingModel"
                                HeaderIcon="{ui:FontIcon Glyph=&#xE83B;}">
                                <ComboBox
                                    ItemsSource="{x:Bind viewModel.Models}"
                                    SelectedIndex="{x:Bind viewModel.EmbeddingModelIndex, Mode=TwoWay}" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
