<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Kusatsu.DataTemplates.ItemTableTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Maiko.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:Kusatsu.Converters"
    xmlns:local="using:Kusatsu.DataTemplates">
    <converters:DateValueConverter x:Key="KusatsuDateTimeConverter" />

    <DataTemplate
        x:Key="ItemTableTemplate"
        x:DataType="models:Item">
        <controls:DataRow>
            <TextBlock Text="{Binding Id}" />
            <TextBlock Text="{Binding DateTime, Converter={StaticResource KusatsuDateTimeConverter}}" />
            <TextBlock Text="{Binding Category.MediumCategory.LargeCategory.Name}" />
            <TextBlock Text="{Binding Category.MediumCategory.Name}" />
            <TextBlock Text="{Binding Category.Name}" />
            <TextBlock Text="{Binding Name}" TextWrapping="WrapWholeWords" />
            <TextBlock Text="{Binding Method.Name}" />
            <TextBlock Text="{Binding Amount}" />
        </controls:DataRow>
    </DataTemplate>
</ResourceDictionary>
